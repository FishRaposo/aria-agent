# Connected provider: failed network requests and HTTP errors are displayed.
# It never automatically substitutes fixture runs, chat answers, or decisions.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set true for a credential-free, tab-local interactive simulation.
# npm run demo:ui sets this explicitly. Reload/reset restores the fixtures.
NEXT_PUBLIC_DEMO_MODE=false

# Set CORS_ALLOWED_ORIGINS=http://localhost:3000 in the BACKEND launch shell
# to opt into browser access from the default frontend development origin.
