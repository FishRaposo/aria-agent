# App General Settings
APP_NAME=hermes-agent-framework
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database Connection (OPTIONAL).
# The service probes this on startup and falls back to in-memory stores if it is
# unreachable, so it runs with no database. Set it to persist runs/tasks/
# approvals/memory. Use host.docker.internal from containers, localhost on host.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
DB_PROBE_TIMEOUT=2

# Redis / Celery (OPTIONAL — only needed for the async worker).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Agent behaviour
AGENT_MODE=free_running          # free_running | approval_gated
AGENT_ROUTING=auto               # auto | llm | keyword
AGENT_MAX_STEPS=5
APPROVAL_TIMEOUT_SECONDS=300

# Tool sandboxing
HERMES_SANDBOX_DIR=./sandbox     # file_reader is confined to this directory
# HERMES_SEARCH_API_URL=https://api.example.com/search  # enables real web_search

# External LLM APIs (OPTIONAL — routing/responses are simulated without keys).
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GITHUB_TOKEN=your-github-token
